# Copy this file to .env.local (same folder) and fill in real values.
# .env.local is already gitignored at the repo root - never commit real secrets.

# Get these free at https://dashboard.plaid.com/signup - Sandbox access is
# instant, no business verification required.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Existing Plaid starter environments that use CLIENT_ID/SANDBOX_SECRET are
# also supported, so secrets do not need to be duplicated.
# Sandbox accounts stay visible as a read-only provider connection without
# changing the Sarah demo forecast. Set to 1 only when intentionally replacing
# the demo data path with Plaid data.
RELIEF_USE_PLAID_FOR_FORECAST=0

# ReliefFM model services. Mini is a customer-visible shadow preview only;
# deterministic forecasting continues to drive intervention workflows.
RELIEFFM_MINI_URL=http://127.0.0.1:8080
RELIEFFM_FLASH_URL=
