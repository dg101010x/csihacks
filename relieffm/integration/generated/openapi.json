      "get": {
        "operationId": "metadata_model_v1_metadata_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metadata"
      }
    },
