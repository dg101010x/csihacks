            "title": "Known Future Events",
            "type": "array"
          },
          "obligations": {
            "items": {
              "$ref": "#/components/schemas/Obligation"
            },
            "title": "Obligations",
            "type": "array"
          }
        },
        "required": [
          "household_id",
          "currency",
          "as_of",
          "household_state"
        ],
        "title": "HouseholdSnapshotV1",
        "type": "object"
      },
      "HouseholdState": {
        "additionalProperties": false,
        "description": "12.1 Household state token.",
        "properties": {
          "available_balance_cents": {
            "title": "Available Balance Cents",
            "type": "integer"
          },
          "data_freshness_hours": {
            "minimum": 0.0,
            "title": "Data Freshness Hours",
            "type": "number"
          },
          "essential_reserve_cents": {
            "minimum": 0.0,
            "title": "Essential Reserve Cents",
            "type": "integer"
          },
          "num_accounts": {
            "minimum": 0.0,
            "title": "Num Accounts",
            "type": "integer"
          },
          "num_obligations": {
            "minimum": 0.0,
            "title": "Num Obligations",
            "type": "integer"
          },
          "snapshot_completeness": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Snapshot Completeness",
            "type": "number"
