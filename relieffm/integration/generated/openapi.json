          "obligation_id",
          "obligation_type",
          "scheduled_amount_cents",
          "due_date",
          "recurrence",
          "essentiality_category",
          "account_id"
        ],
        "title": "Obligation",
        "type": "object"
      },
      "ObligationType": {
        "enum": [
          "rent",
          "mortgage",
          "auto_loan",
          "personal_loan",
          "credit_card_minimum",
          "insurance_premium",
          "utility",
          "subscription",
          "bnpl",
          "medical_payment_plan"
        ],
        "title": "ObligationType",
        "type": "string"
      },
      "PaymentStatus": {
        "enum": [
          "current",
          "late",
          "missed",
          "in_hardship_program"
        ],
        "title": "PaymentStatus",
        "type": "string"
      },
      "RecurrenceState": {
        "enum": [
          "none",
          "weekly",
          "biweekly",
          "semimonthly",
          "monthly",
          "irregular"
        ],
        "title": "RecurrenceState",
        "type": "string"
      },
      "SourceType": {
        "enum": [
          "bank_feed",
          "card_feed",
          "manual",
          "simulated",
          "provider_confirmed"
        ],
        "title": "SourceType",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
