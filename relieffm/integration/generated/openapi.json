          "num_obligations",
          "essential_reserve_cents",
          "data_freshness_hours",
          "snapshot_completeness"
        ],
        "title": "HouseholdState",
        "type": "object"
      },
      "Intervention": {
        "additionalProperties": false,
        "properties": {
          "action_type": {
            "title": "Action Type",
            "type": "string"
