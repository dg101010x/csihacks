          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          }
        },
        "required": [
          "action_type",
          "obligation_id"
        ],
        "title": "Intervention",
        "type": "object"
      },
      "InterventionSimulationRequestV1": {
        "additionalProperties": false,
        "properties": {
          "base_forecast_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Forecast Id"
          },
          "contract_version": {
            "title": "Contract Version",
            "type": "string"
          },
          "horizon_days": {
            "exclusiveMinimum": 0.0,
            "maximum": 180.0,
            "title": "Horizon Days",
            "type": "integer"
          },
          "intervention": {
            "$ref": "#/components/schemas/Intervention"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "scenario_count": {
            "maximum": 256.0,
            "minimum": 0.0,
            "title": "Scenario Count",
            "type": "integer"
          },
          "snapshot": {
            "$ref": "#/components/schemas/HouseholdSnapshotV1"
          }
        },
        "required": [
          "contract_version",
          "request_id",
          "snapshot",
          "intervention",
          "horizon_days",
          "scenario_count"
        ],
        "title": "InterventionSimulationRequestV1",
        "type": "object"
      },
      "KnownFutureEvent": {
        "additionalProperties": false,
        "description": "12.5 Known future event token. Constraint, not a prediction target.",
        "properties": {
          "account_id": {
            "title": "Account Id",
            "type": "string"
          },
          "amount_cents": {
            "title": "Amount Cents",
            "type": "integer"
          },
          "direction": {
            "$ref": "#/components/schemas/Direction"
          },
          "effective_time": {
            "format": "date-time",
            "title": "Effective Time",
            "type": "string"
          },
          "event_id": {
            "title": "Event Id",
            "type": "string"
          },
          "event_type": {
            "$ref": "#/components/schemas/EventType"
          },
          "obligation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
