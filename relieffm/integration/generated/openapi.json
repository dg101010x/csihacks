{
  "components": {
    "schemas": {
      "AccountState": {
        "additionalProperties": false,
        "description": "12.2 Account state token.",
        "properties": {
          "account_id": {
            "title": "Account Id",
            "type": "string"
          },
          "account_subtype": {
            "default": "",
            "title": "Account Subtype",
            "type": "string"
          },
          "account_type": {
            "$ref": "#/components/schemas/AccountType"
          },
          "available_balance_cents": {
            "title": "Available Balance Cents",
            "type": "integer"
          },
          "credit_limit_cents": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credit Limit Cents"
          },
          "current_balance_cents": {
            "title": "Current Balance Cents",
            "type": "integer"
          },
          "data_freshness_hours": {
            "minimum": 0.0,
            "title": "Data Freshness Hours",
            "type": "number"
          },
          "institution_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Institution Ref"
          }
        },
        "required": [
          "account_id",
          "account_type",
          "current_balance_cents",
          "available_balance_cents",
          "data_freshness_hours"
        ],
        "title": "AccountState",
        "type": "object"
      },
      "AccountType": {
        "enum": [
          "checking",
          "savings",
          "credit_card",
          "loan",
          "brokerage"
        ],
        "title": "AccountType",
        "type": "string"
      },
      "Direction": {
        "enum": [
          "inflow",
          "outflow"
        ],
        "title": "Direction",
        "type": "string"
      },
      "EssentialityCategory": {
        "enum": [
          "essential",
          "discretionary"
        ],
        "title": "EssentialityCategory",
        "type": "string"
      },
      "EventStatus": {
        "enum": [
          "posted",
          "pending",
          "scheduled",
          "cancelled",
          "failed"
        ],
        "title": "EventStatus",
        "type": "string"
      },
      "EventType": {
        "enum": [
          "paycheck",
          "rent_payment",
          "mortgage_payment",
          "auto_loan_payment",
          "personal_loan_payment",
          "credit_card_payment",
          "insurance_premium",
          "utility_bill",
          "subscription",
          "bnpl_payment",
          "medical_payment",
          "transfer",
          "fee",
          "refund",
          "purchase",
          "deposit",
          "withdrawal",
          "shock_expense",
          "other"
        ],
        "title": "EventType",
        "type": "string"
      },
      "ForecastRequestV1": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "title": "Contract Version",
            "type": "string"
          },
          "horizon_days": {
            "exclusiveMinimum": 0.0,
            "maximum": 180.0,
            "title": "Horizon Days",
            "type": "integer"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "requested_outputs": {
            "items": {
              "type": "string"
            },
            "title": "Requested Outputs",
            "type": "array"
          },
          "scenario_count": {
            "maximum": 256.0,
            "minimum": 0.0,
            "title": "Scenario Count",
            "type": "integer"
          },
          "snapshot": {
            "$ref": "#/components/schemas/HouseholdSnapshotV1"
          }
        },
        "required": [
          "contract_version",
          "request_id",
          "snapshot",
          "horizon_days",
          "scenario_count"
        ],
        "title": "ForecastRequestV1",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HistoricalEvent": {
        "additionalProperties": false,
        "description": "12.3 Observed financial event token.",
        "properties": {
          "account_id": {
            "title": "Account Id",
            "type": "string"
          },
          "amount_cents": {
            "title": "Amount Cents",
            "type": "integer"
          },
          "direction": {
            "$ref": "#/components/schemas/Direction"
          },
          "effective_time": {
            "format": "date-time",
            "title": "Effective Time",
            "type": "string"
          },
          "event_id": {
            "title": "Event Id",
            "type": "string"
          },
          "event_status": {
            "$ref": "#/components/schemas/EventStatus"
          },
          "event_type": {
            "$ref": "#/components/schemas/EventType"
          },
          "merchant_category": {
            "default": "unknown",
            "title": "Merchant Category",
            "type": "string"
          },
          "occurrence_time": {
            "format": "date-time",
            "title": "Occurrence Time",
            "type": "string"
          },
          "recurrence_state": {
            "$ref": "#/components/schemas/RecurrenceState",
            "default": "none"
          },
          "source_type": {
            "$ref": "#/components/schemas/SourceType",
            "default": "simulated"
          },
          "transaction_confidence": {
            "default": 1.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Transaction Confidence",
            "type": "number"
          }
        },
        "required": [
          "event_id",
          "event_type",
          "event_status",
          "amount_cents",
          "direction",
          "account_id",
          "occurrence_time",
          "effective_time"
        ],
        "title": "HistoricalEvent",
        "type": "object"
      },
      "HouseholdSnapshotV1": {
        "additionalProperties": false,
        "properties": {
          "accounts": {
            "items": {
              "$ref": "#/components/schemas/AccountState"
            },
            "title": "Accounts",
            "type": "array"
          },
          "as_of": {
